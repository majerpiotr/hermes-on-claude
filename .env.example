# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Claude subscription token  (REQUIRED)
# ---------------------------------------------------------------------------
# This is the only credential in the stack, and it lives ONLY in the
# claude-shim container. The Hermes container never receives it: Hermes runs a
# shell driven by an LLM, so anything it can read is one prompt injection away
# from leaving the machine.
#
# Mint it on a machine that has a browser (your laptop, not the VPS):
#
#   claude setup-token
#
# It prints a token valid for 12 months. Paste it below AS ONE UNBROKEN LINE.
# The value is ~108 characters; if your editor wraps it, .env keeps only the
# first part and you get "401 OAuth access token is invalid" with a token that
# looks correct. Verify with:
#
#   awk -F= '/^CLAUDE_CODE_OAUTH_TOKEN=/ {print "token length:", length($2)}' .env
#
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard access  (REQUIRED)
# ---------------------------------------------------------------------------
# The Hermes dashboard is fail-closed: it refuses to bind 0.0.0.0 without an
# auth provider, and inside Docker it must bind 0.0.0.0 for the published port
# to reach it. Publishing on localhost is not a substitute for setting these.
#
# Generate a password:  openssl rand -hex 24
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Signs the dashboard session cookie. Leave it empty and setup.sh generates one
# here on the first run. Without it Hermes picks a random key per process, so
# every `docker compose restart hermes` logs you out of the dashboard.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Where Hermes keeps its state
# ---------------------------------------------------------------------------
# Default is ./hermes-home inside this repo, created on first run. Point it at
# an existing Hermes data directory (the one bind-mounted to /opt/data) to
# adopt that installation instead: its sessions, memories, skills and platform
# credentials are kept, and setup.sh only adds the keys that are missing.
#
#   HERMES_DATA_DIR=/srv/hermes
HERMES_DATA_DIR=./hermes-home

# ---------------------------------------------------------------------------
# Where to publish the dashboard and gateway ports
# ---------------------------------------------------------------------------
# Governs the Hermes dashboard and gateway ports only, not the shim (see
# SHIM_BIND_ADDR below). 127.0.0.1 means "reachable only from the machine
# itself". On a VPS that means you need an SSH tunnel:
#
#   ssh -L 9119:localhost:9119 user@your-vps
#
# If you use a private mesh network (Tailscale, WireGuard), set this to that
# interface's address instead, e.g. BIND_ADDR=100.x.y.z, and reach the
# dashboard directly from any machine on the mesh.
#
# Never set this to 0.0.0.0 on a public VPS.
BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Where to publish the shim port
# ---------------------------------------------------------------------------
# The shim has no authentication of any kind: anyone who can reach this port
# can spend your Claude subscription. Keep it at 127.0.0.1, or comment out
# its port publication in docker-compose.yml entirely if you never need to
# curl it directly. Hermes itself reaches the shim over the internal Docker
# network regardless of this setting.
#
# Do NOT set this to the same mesh address you use for BIND_ADDR.
SHIM_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Cost guard
# ---------------------------------------------------------------------------
# Hard ceiling per single model call, in USD. Note this is a notional figure at
# standard API rates -- on a subscription you are not billed per token, you
# consume your plan's allowance -- but it is the only common unit available and
# it does stop a runaway loop.
CLAUDE_SHIM_MAX_BUDGET_USD=2.00

# Seconds before a single model call is killed.
CLAUDE_SHIM_TIMEOUT=300

# INFO or DEBUG. DEBUG logs the full CLI argv for each call.
CLAUDE_SHIM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
# Defaults are sized for a small VPS (2 vCPU / 4 GB, e.g. Hetzner CX22/CX23):
# 2G + 1G leaves ~1 GB for the host, and 1.5 + 0.5 fits 2 vCPU.
#
# Measured on this stack: Hermes peaks around 480M doing real work (web search
# + terminal + summary), so 2G is comfortable.
HERMES_MEM_LIMIT=2G
HERMES_CPU_LIMIT=1.5

# The shim spawns one `claude` Node process per in-flight model call, and each
# peaks around 260M. Hermes' delegation.max_concurrent_children (3 by default)
# means several can run at once, so this needs room for more than one. Raise it
# if you raise that setting; lower it to 512M if you never use delegation.
SHIM_MEM_LIMIT=1G
SHIM_CPU_LIMIT=0.5

# Shared memory for Chromium. Counts against HERMES_MEM_LIMIT when used.
# Drop to 512m on a tight box if you do not use browser automation.
HERMES_SHM_SIZE=1g
